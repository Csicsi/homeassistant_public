# Copy to the local ESPHome secrets file; do not commit the copy.
wifi_ssid: YOUR_WIFI_SSID
wifi_password: YOUR_WIFI_PASSWORD
fallback_password: YOUR_FALLBACK_AP_PASSWORD
api_encryption_key: YOUR_ESPHOME_API_ENCRYPTION_KEY
ota_password: YOUR_OTA_PASSWORD
io_node_id: YOUR_HOME_IO_NODE_ID
io_system_key: YOUR_HOME_IO_SYSTEM_KEY
